{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: jalankan lokal (port 8090)",
      "type": "debugpy",
      "request": "launch",
      "module": "handover_web",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder};${workspaceFolder}\web", "WEB_PORT": "8090" },
      "serverReadyAction": { "pattern": "siap di (http://\S+)", "uriFormat": "http://localhost:8090", "action": "openExternally" }
    },
    {
      "name": "Bot: jalankan lokal (matikan container bot dulu)",
      "type": "debugpy",
      "request": "launch",
      "module": "handover_bot",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: tes rekap bulan ini",
      "type": "debugpy",
      "request": "launch",
      "module": "handover_bot.cli",
      "args": ["/rekap bulan ini", "--stats"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal"
    }
  ]
}
